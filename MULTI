  src: string
  fallbackSrc: string
}

const HeroVideo: React.FC<HeroVideoProps> = ({ src, fallbackSrc }) => {
  return (
    <div className="relative w-full h-[60vh] md:h-[70vh] bg-white">
      <video
        src={src}
        loop
        autoPlay
        muted
        playsInline
        className="absolute inset-0 w-full h-full object-cover"
      />
      <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-white via-white/40 to-white/70" />
      <img
        src={fallbackSrc || "/placeholder.svg"}
        alt="South Developers Hero Image"
        className="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500"
        onError={(e: any) => {
          e.currentTarget.classList.remove('opacity-0')
        }}
        onLoad={(e: any) => {
          e.currentTarget.classList.remove('opacity-0')
        }}
      />
    </div>
  )
}

export default HeroVideo
